    {
      "id": "f8862922-ee72-4b7f-b414-3221a6dbbb21",
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        224,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://ai.infomaniak.com/<INFOMANIAK_AI_PRODUCT_ID>/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"mistralai/Mistral-Small-4-119B-2603\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Tu es un outil de classification pour une base de connaissances personnelle. Analyse le contenu fourni. Réponds uniquement en JSON valide avec les champs title, filename, summary et tags. title doit être court et explicite. filename doit etre une version de titre sans caractère spécial, juste un suite de motavec des tirets comme un slug. summary doit contenir 1 à 3 phrases. tags doit être une liste de 3 à 7 tags courts, en minuscules, sans #.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.body.text) }}\n    }\n  ],\n  \"stream\": false,\n  \"temperature\": 0.2,\n  \"response_format\": {\n    \"type\": \"json_schema\",\n    \"json_schema\": {\n      \"name\": \"kb_classification\",\n      \"strict\": true,\n      \"schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"title\": { \"type\": \"string\" },\n          \"summary\": { \"type\": \"string\" },\n          \"filename\": { \"type\": \"string\" },\n          \"tags\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n        },\n        \"required\": [\"title\", \"summary\", \"tags\"],\n        \"additionalProperties\": false\n      }\n    }\n  }\n}",
        "options": {}
      },
      "credentials": {
        "httpBearerAuth": {
          "id": "REPLACE_ME",
          "name": "Bearer Auth account"
        }
      }
    },
    {
      "id": "ccf1ab51-7468-46d0-91ae-622189ecbadd",

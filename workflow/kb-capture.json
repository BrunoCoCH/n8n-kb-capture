    {
      "id": "32864d4a-86e0-441c-bc9c-c0fd234865a6",
      "name": "Save Image to Disk",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const fs = require('fs');\nconst path = require('path');\n\n// Find the uploaded image in the webhook item's binary properties (n8n names it data0, data1...)\nconst wh = $('Webhook').first();\nconst bin = wh.binary || {};\n\nlet binaryData = null;\nfor (const key of Object.keys(bin)) {\n  const b = bin[key];\n  if (b && b.data && b.mimeType && b.mimeType.startsWith('image/')) { binaryData = b; break; }\n}\nif (!binaryData) {\n  for (const key of Object.keys(bin)) {\n    if (bin[key] && bin[key].data) { binaryData = bin[key]; break; }\n  }\n}\n\nif (!binaryData || !binaryData.data) {\n  throw new Error('No image found in webhook. Binary keys: ' + JSON.stringify(Object.keys(bin)));\n}\n\nconst filename = $input.first().json.filename;\nif (!filename) {\n  throw new Error('No filename produced by the AI step.');\n}\n\nconst dir = '/home/ubuntu/n8n/media';\nconst filepath = path.join(dir, filename + '.png');\nfs.mkdirSync(dir, { recursive: true });\nconst buf = Buffer.from(binaryData.data, 'base64');\nfs.writeFileSync(filepath, buf);\n\n// Pass the binary through as 'data' for downstream nodes (kDrive upload)\nreturn [{\n  json: { ...$input.first().json, saved_to: filepath, file_size: buf.length },\n  binary: { data: binaryData }\n}];"
      }
    },
